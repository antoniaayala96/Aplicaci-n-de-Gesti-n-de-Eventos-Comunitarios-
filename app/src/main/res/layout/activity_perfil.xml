<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:text="Mi Perfil"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/imgAvatarPerfil"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="32dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Avatar de usuario" />

    <TextView
        android:id="@+id/tvNombrePerfil"
        android:text="Nombre"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvCorreoPerfil"
        android:text="Correo"
        android:textSize="16sp"
        android:textColor="#64748B"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnMisEventos"
        android:text="Mis eventos"
        android:layout_marginTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnCerrarSesionPerfil"
        android:text="Cerrar sesión"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>