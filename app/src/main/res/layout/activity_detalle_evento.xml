<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgDetalleEvento"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvCategoriaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="#FFFFFF"
            android:background="#2563EB"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvFechaHoraDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha y hora"
            android:textColor="#475569"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvUbicacionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textColor="#475569"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDescripcionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#334155"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnConfirmarAsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asistir"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnCompartirEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compartir evento" />

        <Button
            android:id="@+id/btnEditarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar evento" />

        <Button
            android:id="@+id/btnEliminarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar evento" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentarios y calificación"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginTop="24dp" />

        <RatingBar
            android:id="@+id/ratingEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0" />

        <EditText
            android:id="@+id/etComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="12dp"
            android:hint="Escribe tu comentario"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnGuardarComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar comentario" />

        <TextView
            android:id="@+id/tvComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentarios:"
            android:textColor="#334155"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>